# =============================================================
# IBM Quantum Credentials Template
# =============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is listed in .gitignore.
# This file (.env.template) is safe to commit; it contains
# ONLY placeholder values.
# =============================================================

# Your IBM Quantum API Token (from https://quantum.ibm.com/)
IBM_QUANTUM_TOKEN=YOUR_IBM_QUANTUM_API_KEY_HERE

# Your IBM Quantum Instance (CRN or hub/group/project string)
# Example (Open Plan): ibm-q/open/main
# Example (Premium):   crn:v1:bluemix:public:quantum-computing:...
IBM_QUANTUM_INSTANCE=YOUR_IBM_QUANTUM_INSTANCE_HERE

# Target backend name (e.g. ibm_marrakesh, ibm_kyoto, ibm_brisbane)
# Leave empty to auto-select the least busy physical QPU.
IBM_BACKEND_NAME=YOUR_IBM_BACKEND_NAME_HERE

# Login flow: classic (default, preserves existing login) or live (browser/server BB84 demo).
QPORTAL_LOGIN_MODE=classic

# Existing saved-result key-bank target. This is separate from the live browser login.
QPORTAL_BANK_TARGET=simulator

# Classic-mode login exchange target; live mode never submits login work to IBM hardware.
QPORTAL_LOGIN_TARGET=simulator
